# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ★ 例外：.env.example 是【模板、无真实值】，应当入库（否则新环境无从得知要配哪些键）
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 临时产物与大缓存（不入库）
temp/
.geonames-cache/
