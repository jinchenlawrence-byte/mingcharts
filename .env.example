# 环境变量配置模板
# ① 本地开发：复制此文件为 .env.local 并填入实际值
# ② ★ 部署到 Vercel 时：这些键要在
#      Vercel 后台 → Project → Settings → Environment Variables 里【逐个配置】
#      ★★ 绝不要把 .env.local 上传到任何地方（.vercelignore 与 .gitignore 均已排除）

# ────────── Supabase（从 https://supabase.com 创建项目获取）──────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# ★★ 服务端专用，可绕过 RLS —— 【绝不可暴露给浏览器、绝不可写成 NEXT_PUBLIC_ 前缀】
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ────────── AI 文本生成（命书 / 年运 / 合婚 / 紫微 / 地理 的解读文本）──────────
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=your_ai_base_url_here
AI_MODEL=your_ai_model_here

# ────────── 智谱 AI ──────────
ZHIPU_API_KEY=your_zhipu_api_key_here

# ────────── 微信支付（可选，后续接入）──────────
# WECHAT_APP_ID=your_wechat_app_id
# WECHAT_MCH_ID=your_wechat_mch_id
# WECHAT_API_KEY=your_wechat_api_key

# ────────── 支付宝（可选，后续接入）──────────
# ALIPAY_APP_ID=your_alipay_app_id
# ALIPAY_PRIVATE_KEY=your_alipay_private_key

# ────────── Waffo 卡支付（https://pancake.waffo.ai，测试模式先接）──────────
# 密钥从 Dashboard → 开发者/API 页面获取；仅服务端使用。
# ★★ WAFFO_PRIVATE_KEY 绝不可暴露给浏览器、绝不可加 NEXT_PUBLIC_ 前缀
WAFFO_MERCHANT_ID=your_waffo_merchant_id_here
WAFFO_PRIVATE_KEY=your_waffo_private_key_here
WAFFO_STORE_ID=your_waffo_store_id_here
# 站点对外可访问的绝对 https 地址（生成 successUrl 用）。
# 本地联调时填 cloudflared/ngrok 隧道地址（★ 禁用 localtunnel，会剥掉验签头）；
# 生产填正式域名，如 https://www.mingcharts.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────── 付费墙总开关（★ 生产【不设】这一项）──────────
# ENTITLEMENT_ENFORCE=true
# ★ 生产环境【绝不设置】⇒ 常量评估为 false，内测期行为不变（26号方案 B）。
#   仅 Preview / 本地验证时设 true 才开启付费墙。
# ★ 必须是【服务端】环境变量：不加 NEXT_PUBLIC_ 前缀（否则会进客户端 bundle）。

# ────────── 服务端出口代理（★ 仅本机开发需要）──────────
# Node.js 服务端默认不走系统代理；本机直连 Supabase/Waffo 被墙时需显式指定。
# ★ 生产 / Vercel【绝不设置这一项】——代码按显式设置走代理，未设置则直连；
#   切勿在 Vercel 后台配置 HTTPS_PROXY（服务端应直连，设了反而可能指向不存在端口全挂）。
# ★ 绝不可写成 NEXT_PUBLIC_ 前缀（仅服务端使用）。
# HTTPS_PROXY=http://127.0.0.1:7897
