# 环境变量配置模板
# ① 本地开发：复制此文件为 .env.local 并填入实际值
# ② ★ 部署到 Vercel 时：这些键要在
#      Vercel 后台 → Project → Settings → Environment Variables 里【逐个配置】
#      ★★ 绝不要把 .env.local 上传到任何地方（.vercelignore 与 .gitignore 均已排除）

# ────────── Supabase（从 https://supabase.com 创建项目获取）──────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# ★★ 服务端专用，可绕过 RLS —— 【绝不可暴露给浏览器、绝不可写成 NEXT_PUBLIC_ 前缀】
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ────────── AI 文本生成（命书 / 年运 / 合婚 / 紫微 / 地理 的解读文本）──────────
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=your_ai_base_url_here
AI_MODEL=your_ai_model_here

# ────────── 智谱 AI ──────────
ZHIPU_API_KEY=your_zhipu_api_key_here

# ────────── 微信支付（可选，后续接入）──────────
# WECHAT_APP_ID=your_wechat_app_id
# WECHAT_MCH_ID=your_wechat_mch_id
# WECHAT_API_KEY=your_wechat_api_key

# ────────── 支付宝（可选，后续接入）──────────
# ALIPAY_APP_ID=your_alipay_app_id
# ALIPAY_PRIVATE_KEY=your_alipay_private_key
